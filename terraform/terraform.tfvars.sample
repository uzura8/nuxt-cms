# Terraform variable definitions

# Project settings
project = "nuxt-cms"
stage   = "dev"

# Region settings
# region_api         = "ap-northeast-1"
region_site        = "ap-northeast-1"
region_acm         = "us-east-1"
region_lambda_edge = "us-east-1"

# =========================
# Domain
# ========================
route53_zone_id              = "ZXXXXXXXXXXXXXXXXXXXX"
# domain_api                   = "app-dev.example.com"
domain_static_site           = "www.example.com"
s3_static_site_force_destroy = true # 本番では false にする

# =========================
# Nuxt SSR（CloudFront 第 2 オリジン /posts*）
# =========================
# serverless info の endpoints から https:// を除いたホスト名を指定する。
# 例: ANY - https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/
# nuxt_ssr_http_api_host = "xxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com"

